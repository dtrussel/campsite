lines = [{
"id": "bark.boss.leo.1",
"speaker": "leo",
"text": "It's HUGE! Stay by the fire!",
"trigger": "boss"
}, {
"id": "bark.boss.leo.2",
"speaker": "leo",
"text": "That's the Moon-Eater!",
"trigger": "boss"
}, {
"id": "bark.boss.nela.1",
"speaker": "nela",
"text": "Look at its belly. The moon!",
"trigger": "boss"
}, {
"id": "bark.boss.nela.2",
"speaker": "nela",
"text": "It's so big... and so sad.",
"trigger": "boss"
}, {
"id": "bark.boss_lantern.leo.1",
"speaker": "leo",
"text": "Hey! Not our lantern!",
"trigger": "boss_lantern"
}, {
"id": "bark.boss_lantern.leo.2",
"speaker": "leo",
"text": "Quick! It wants the lantern!",
"trigger": "boss_lantern"
}, {
"id": "bark.boss_lantern.nela.1",
"speaker": "nela",
"text": "It's eating the light! Hurry!",
"trigger": "boss_lantern"
}, {
"id": "bark.boss_lantern.nela.2",
"speaker": "nela",
"text": "Get it off the lantern!",
"trigger": "boss_lantern"
}, {
"id": "bark.low_hp.leo.1",
"speaker": "leo",
"text": "Ow! I need a breather!",
"trigger": "low_hp"
}, {
"id": "bark.low_hp.leo.2",
"speaker": "leo",
"text": "That one stung!",
"trigger": "low_hp"
}, {
"id": "bark.low_hp.leo.3",
"speaker": "leo",
"text": "Not looking good...",
"trigger": "low_hp"
}, {
"id": "bark.low_hp.nela.1",
"speaker": "nela",
"text": "Ouch! I need a second!",
"trigger": "low_hp"
}, {
"id": "bark.low_hp.nela.2",
"speaker": "nela",
"text": "I'm hurt, cover me!",
"trigger": "low_hp"
}, {
"id": "bark.low_hp.nela.3",
"speaker": "nela",
"text": "That really hurt!",
"trigger": "low_hp"
}, {
"id": "bark.thief.leo.1",
"speaker": "leo",
"text": "Hey! That's our stuff!",
"trigger": "thief"
}, {
"id": "bark.thief.leo.2",
"speaker": "leo",
"text": "It's taking it to the Hollow!",
"trigger": "thief"
}, {
"id": "bark.thief.nela.1",
"speaker": "nela",
"text": "After that sneaky thing!",
"trigger": "thief"
}, {
"id": "bark.thief.nela.2",
"speaker": "nela",
"text": "It's got our supplies!",
"trigger": "thief"
}, {
"id": "bark.thief_caught.leo.1",
"speaker": "leo",
"text": "Got it back!",
"trigger": "thief_caught"
}, {
"id": "bark.thief_caught.leo.2",
"speaker": "leo",
"text": "Ha! Drop that!",
"trigger": "thief_caught"
}, {
"id": "bark.thief_caught.nela.1",
"speaker": "nela",
"text": "Nice try, mushroom!",
"trigger": "thief_caught"
}, {
"id": "bark.thief_caught.nela.2",
"speaker": "nela",
"text": "That's ours, thank you!",
"trigger": "thief_caught"
}, {
"id": "bark.first_beast.leo.1",
"speaker": "leo",
"text": "Whoa, a tree is walking!",
"trigger": "first_beast"
}, {
"id": "bark.first_beast.leo.2",
"speaker": "leo",
"text": "That old tree woke up angry!",
"trigger": "first_beast"
}, {
"id": "bark.first_beast.nela.1",
"speaker": "nela",
"text": "Bramble Beast! Watch out!",
"trigger": "first_beast"
}, {
"id": "bark.first_beast.nela.2",
"speaker": "nela",
"text": "Keep it off the tent!",
"trigger": "first_beast"
}, {
"id": "bark.level_up.leo.1",
"speaker": "leo",
"text": "I'm getting stronger!",
"trigger": "level_up"
}, {
"id": "bark.level_up.leo.2",
"speaker": "leo",
"text": "Ranger skills, up!",
"trigger": "level_up"
}, {
"id": "bark.level_up.nela.1",
"speaker": "nela",
"text": "I'm getting better at this!",
"trigger": "level_up"
}, {
"id": "bark.level_up.nela.2",
"speaker": "nela",
"text": "Ooh, I learned something!",
"trigger": "level_up"
}, {
"id": "bark.sunset.leo.1",
"speaker": "leo",
"text": "Sun's going down!",
"trigger": "sunset"
}, {
"id": "bark.sunset.leo.2",
"speaker": "leo",
"text": "Everybody back to camp!",
"trigger": "sunset"
}, {
"id": "bark.sunset.nela.1",
"speaker": "nela",
"text": "It's getting dark, Leo!",
"trigger": "sunset"
}, {
"id": "bark.sunset.nela.2",
"speaker": "nela",
"text": "Light the torches!",
"trigger": "sunset"
}, {
"id": "bark.night_start.leo.1",
"speaker": "leo",
"text": "Here they come!",
"trigger": "night_start"
}, {
"id": "bark.night_start.leo.2",
"speaker": "leo",
"text": "Stick ready. Let's go!",
"trigger": "night_start"
}, {
"id": "bark.night_start.nela.1",
"speaker": "nela",
"text": "Stay close to the light!",
"trigger": "night_start"
}, {
"id": "bark.night_start.nela.2",
"speaker": "nela",
"text": "Slingshot's loaded!",
"trigger": "night_start"
}, {
"id": "bark.lantern_stage.leo.1",
"speaker": "leo",
"text": "The lantern's brighter!",
"trigger": "lantern_stage"
}, {
"id": "bark.lantern_stage.leo.2",
"speaker": "leo",
"text": "Look, it's glowing!",
"trigger": "lantern_stage"
}, {
"id": "bark.lantern_stage.nela.1",
"speaker": "nela",
"text": "The moonlight's coming back!",
"trigger": "lantern_stage"
}, {
"id": "bark.lantern_stage.nela.2",
"speaker": "nela",
"text": "The light is growing!",
"trigger": "lantern_stage"
}, {
"id": "bark.companion_down.leo.1",
"speaker": "leo",
"text": "Hang on, Nela! I'm coming!",
"trigger": "companion_down"
}, {
"id": "bark.companion_down.leo.2",
"speaker": "leo",
"text": "No! Get up!",
"trigger": "companion_down"
}, {
"id": "bark.companion_down.nela.1",
"speaker": "nela",
"text": "Hang on, Leo! I'm coming!",
"trigger": "companion_down"
}, {
"id": "bark.companion_down.nela.2",
"speaker": "nela",
"text": "Oh no! Rest, I've got this!",
"trigger": "companion_down"
}, {
"id": "bark.companion_up.leo.1",
"speaker": "leo",
"text": "I'm okay! Back in it!",
"trigger": "companion_up"
}, {
"id": "bark.companion_up.leo.2",
"speaker": "leo",
"text": "Phew. I'm good!",
"trigger": "companion_up"
}, {
"id": "bark.companion_up.nela.1",
"speaker": "nela",
"text": "I'm back! Let's go!",
"trigger": "companion_up"
}, {
"id": "bark.companion_up.nela.2",
"speaker": "nela",
"text": "Feeling better now!",
"trigger": "companion_up"
}, {
"id": "bark.danger_behind.leo.1",
"speaker": "leo",
"text": "Behind you!",
"trigger": "danger_behind"
}, {
"id": "bark.danger_behind.leo.2",
"speaker": "leo",
"text": "Watch your back!",
"trigger": "danger_behind"
}, {
"id": "bark.danger_behind.nela.1",
"speaker": "nela",
"text": "Leo! Behind you!",
"trigger": "danger_behind"
}, {
"id": "bark.danger_behind.nela.2",
"speaker": "nela",
"text": "Look out, behind!",
"trigger": "danger_behind"
}, {
"id": "bark.night_start.leo.3",
"speaker": "leo",
"text": "They just want our warm fire!",
"trigger": "night_start"
}, {
"id": "bark.night_start.nela.3",
"speaker": "nela",
"text": "Poor cold shadows. Still no!",
"trigger": "night_start"
}, {
"id": "bark.danger_behind.leo.3",
"speaker": "leo",
"text": "Nela, turn around!",
"trigger": "danger_behind"
}, {
"id": "bark.danger_behind.nela.3",
"speaker": "nela",
"text": "Something's sneaking up!",
"trigger": "danger_behind"
}, {
"id": "bark.thief_escaped.leo.1",
"speaker": "leo",
"text": "Aw, it got away!",
"trigger": "thief_escaped"
}, {
"id": "bark.thief_escaped.leo.2",
"speaker": "leo",
"text": "Gone... into the Hollow.",
"trigger": "thief_escaped"
}, {
"id": "bark.thief_escaped.nela.1",
"speaker": "nela",
"text": "It ran off to the Hollow!",
"trigger": "thief_escaped"
}, {
"id": "bark.thief_escaped.nela.2",
"speaker": "nela",
"text": "Next time, mushroom!",
"trigger": "thief_escaped"
}]
