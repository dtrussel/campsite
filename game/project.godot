; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be manually edited in an emergency.
; Resource paths can be relative or absolute; if the file is moved, all
; paths will be relative to the new file location.

config_version=5

[application]

config/name="Campsite Chronicles"
config/description="A stylized 3D base-builder survival defense game. Protect your family campsite from night-time forest mobs."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
TimeManager="*res://scripts/game_loop/time_manager.gd"
ResourceManager="*res://scripts/core/resource_manager.gd"
ProgressionManager="*res://scripts/core/progression_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

