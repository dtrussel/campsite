; Engine configuration file for the Campsite project.
;
; This file is intended to be opened by Godot 4.x (standard, not .NET).
; It declares the project name, the main scene, the autoloads, and the
; input map used by the prototype skeleton.

config_version=5

[application]

config/name="Campsite"
config/description="Stylized 3D base-builder / survival defense prototype. See README.md and docs/."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
TimeManager="*res://scripts/core/time_manager.gd"
ResourceManager="*res://scripts/core/resource_manager.gd"
BuildManager="*res://scripts/core/build_manager.gd"
ProgressionManager="*res://scripts/core/progression_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

