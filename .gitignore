# Godot 4 specific ignores
.godot/
.import/
*.translation

# Exported builds
build/
export/
exports/
*.exe
*.pck
*.zip

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.tmp

# Logs and crash dumps
*.log
*.dmp

# User-local Godot overrides
override.cfg

# Local credentials / env
.env
.env.local

# Tooling caches
.claude/worktrees/
node_modules/
__pycache__/
*.pyc

# Blender (bpy) venv for art builds
.venv-blender/

# Python venv for procedural audio builds
.venv-audio/
# Voice TTS model files (art/audio/voice.py downloads them)
art/audio/.voice-cache/
